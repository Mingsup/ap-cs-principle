
# 1

```text
PROCEDURE addOne(x)
{
  RETURN(x + 1)
}

PROCEDURE convert(x)
{
  IF x MOD 2 = 0
  {
    RETURN(addOne(x))
  }
  ELSE
  {
    RETURN(addOne(x + 1))
  }
}

PROCEDURE valid(x)
{
  IF x ≥ 4 AND x ≤ 8
  {
    RETURN(true)
  }
  ELSE
  {
    RETURN(false)
  }
}

nums ← [2, 3, 5, 6, 8]
i ← 1
count ← 0
sum ← 0

REPEAT 5 TIMES
{
  value ← convert(nums[i])

  IF valid(value)
  {
    count ← count + 1
    sum ← sum + value
  }

  i ← i + 1
}

DISPLAY(count)
DISPLAY(sum)
```

