nums ← [3, 8, 2, 7, 6]
count ← 0
sum ← 0
i ← 1

REPEAT 5 TIMES
{
  IF nums[i] > 4
  {
    count ← count + 1
    sum ← sum + nums[i]
  }
  ELSE
  {
    sum ← sum + 1
  }

  i ← i + 1
}

DISPLAY(count)
DISPLAY(sum)


