PROCEDURE valid(x)
{
  IF x ≥ 4 AND x ≤ 9
  {
    IF NOT(x = 6)
    {
      RETURN(true)
    }
    ELSE
    {
      RETURN(false)
    }
  }
  ELSE
  {
    RETURN(false)
  }
}

nums ← [3, 4, 6, 8, 10]
i ← 1
count ← 0
sum ← 0

REPEAT 5 TIMES
{
  IF valid(nums[i])
  {
    count ← count + 1
    sum ← sum + nums[i]
  }
  ELSE
  {
    sum ← sum + 1
  }

  i ← i + 1
}

