
## 1

```text
PROCEDURE adjust(x)
{
  IF x MOD 3 = 0
  {
    RETURN(x - 1)
  }
  ELSE
  {
    RETURN(x + 2)
  }
}

PROCEDURE check(x)
{
  IF x > 4 AND x < 10
  {
    RETURN(true)
  }
  ELSE
  {
    RETURN(false)
  }
}

vals ← [3, 4, 6, 8, 9]
i ← 1
count ← 0
sum ← 0

REPEAT 5 TIMES
{
  num ← adjust(vals[i])

  IF check(num)
  {
    count ← count + 1
    sum ← sum + num
  }

  i ← i + 1
}

DISPLAY(count)
DISPLAY(sum)
```

